# Local .terraform directories (contains downloaded binaries)
**/.terraform/*

# .tfstate files (prevents leaking sensitive credentials and infrastructure data)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars variables files (contains secrets/passwords)
*.tfvars
*.tfvars.json

# Ignore local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc